# Response headers for static hosts that read a _headers file (Netlify, Cloudflare
# Pages). This file is preparation only: nothing has been deployed. Other hosts need
# the same headers set in their own configuration (see README, "Content Security
# Policy"). `npm run preview` applies the /* block below, so the browser tests run
# against the same policy.
#
# Paths are relative to the root of the uploaded folder. Under a sub-path, set the
# same headers for that sub-path on the host.
#
# script-src 'self': the pre-paint theme script is the same-origin file
# theme-init.js, so no inline script, hash, or 'unsafe-inline' is allowed.
# style-src 'self': all CSS is in built files; the few runtime style values are set
# through the DOM's style API, which this policy does not block.
# connect-src 'self': the page makes no requests of its own; the service worker needs
# same-origin fetches to precache the app. No other origin can be contacted.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; manifest-src 'self'; worker-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# The shell and worker must be revalidated so a new release is noticed promptly.
# A request for the site root (/) does not match /index.html, so it has its own rule.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/theme-init.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# Built files under assets/ have content hashes in their names.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
